----------------------------------------------------------
-- 飞行过去的逻辑
----------------------------------------------------------

local flyingToTarget = false
local cancelRequested = false
local currentConnection = nil
local currentBodyVelocity = nil
local currentBodyGyro = nil

local function cleanupFly()
    if currentConnection then
        currentConnection:Disconnect()
        currentConnection = nil
    end
    if currentBodyVelocity then
        currentBodyVelocity:Destroy()
        currentBodyVelocity = nil
    end
    if currentBodyGyro then
        currentBodyGyro:Destroy()
        currentBodyGyro = nil
    end
    humanoid.PlatformStand = false
    flyingToTarget = false
    cancelRequested = false
end

local function flyTo(targetCFrame)
    if not targetCFrame then return end
    if flyingToTarget then return end -- 防止重复触发

    flyingToTarget = true
    cancelRequested = false
    humanoid.PlatformStand = true

    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Parent = rootPart
    currentBodyVelocity = bodyVelocity

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.P = 10000
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart
    currentBodyGyro = bodyGyro

    local connection
    connection = RunService.RenderStepped:Connect(function()
        if cancelRequested then
            connection:Disconnect()
            cleanupFly()
            return
        end

        if not rootPart or not rootPart.Parent then
            connection:Disconnect()
            cleanupFly()
            return
        end

        local targetPos = targetCFrame.Position
        local currentPos = rootPart.Position
        local distance = (targetPos - currentPos).Magnitude

        if distance < 2 then
            connection:Disconnect()
            cleanupFly()
            return
        end

        local direction = (targetPos - currentPos).Unit
        bodyVelocity.Velocity = direction * flySpeed
        bodyGyro.CFrame = CFrame.new(currentPos, targetPos)
    end)

    currentConnection = connection
end

local function cancelFly()
    if flyingToTarget then
        cancelRequested = true
    end
end

player.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter
    humanoid = character:WaitForChild("Humanoid")
    rootPart = character:WaitForChild("HumanoidRootPart")
    flyingToTarget = false
    cancelRequested = false
    currentConnection = nil
    currentBodyVelocity = nil
    currentBodyGyro = nil
end)

